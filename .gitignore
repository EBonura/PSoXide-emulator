# Local bios/game files — never commit
bios/
roms/
discs/

# Local raw/source art, purchased packs, and import experiments.
# Keep this near the repo for organization, but never commit it.
local-assets/

# Local repository snapshots are redundant with the canonical Git tree.
/psoxide-tree.tar.gz

# Local share/export packages for external review.
handoff/

# Texture sources under `sdk/examples/*/vendor/` ARE committed —
# but only as pre-cropped 512×512 JPGs, ~50-150 KB each. The
# cooker's centre-square-crop default means feeding it the full
# multi-MB original produces the same byte-for-byte output, so
# there's no reproducibility loss; keeping only the pre-crop
# avoids the 50× size penalty of committing multi-megapixel
# originals. Mesh sources (OBJ) are committed as-is — they're
# KB-range and deterministic from the original.

# Run artifacts
run/
traces/
screenshots/
goldens/*.bin
goldens/*.raw
/build/examples/**/.cargo-build-lock

# Generated by `graphify update .`.
graphify-out/
engine/examples/editor-playtest/build/

# Trunk wasm build output (the web emulator bundle).
emu/crates/frontend/dist/

# Runtime emulator captures (MCP screenshot tool output).
/emu/captures/

# Validation run outputs (make validate writes failure artifacts here).
/validation/artifacts/

