+/// CdlGetID, which `psx_hw::cd` does not name.
+const CD_CMD_GETID: u8 = 0x1A;
+
+/// Clock ticks (Timer 2, system clock) from writing `command` to the first
+/// interrupt of type `want` (3 = first response, 2 = second response). Each
+/// interrupt on the way is acknowledged. The count includes the few hundred
+/// clocks the command write itself takes, which record 0x40 (GetStat) also
+/// includes and which the analysis subtracts. Timer 2 wraps at 65,536, so a
+/// result at or above 0xF000 is reported as a failure rather than aliased.
+fn cd_irq_cycles(command: u8, params: &[u8], want: u8) -> u16 {
+    timers::set_mode(timers::Timer::Timer2, 0);
+    timers::set_counter(timers::Timer::Timer2, 0);
+    let Some(saved) = psx_io::cd::dispatch_command(command, params, CD_SPINS) else {
+        return CD_FAILED;
+    };
+    let mut result = CD_FAILED;
+    loop {
+        let now = timers::counter(timers::Timer::Timer2);
+        if now >= 0xF000 {
+            break;
+        }
+        match psx_io::cd::irq_flag_value() {
+            0 => {}
+            irq => {
+                psx_io::cd::discard_response();
+                psx_io::cd::acknowledge_irq(irq);
+                if irq == want {
+                    result = now;
+                    break;
+                }
+                if irq == 5 {
+                    break;
+                }
+            }
+        }
+    }
+    psx_io::cd::restore_irq_output(saved);
+    result
+}
+
+/// Pause with the motor on and the drive idle: park on the test LBA (a
+/// SeekL leaves the drive paused there), pause once so the state is known,
+/// then time the second Pause. `want` selects INT3 or INT2 as in
+/// [`cd_irq_cycles`].
+fn cd_pause_idle_cycles(want: u8) -> u16 {
+    if !cd_park(CD_TEST_LBA) {
+        return CD_FAILED;
+    }
+    cd_clock_reset();
+    if !cd_command_until_complete_timed(psx_hw::cd::CMD_PAUSE, &[]) {
+        return CD_FAILED;
+    }
+    cd_irq_cycles(psx_hw::cd::CMD_PAUSE, &[], want)
+}
+
+/// Total time (Timer 1 HBlank ticks) of `command` (Pause or Stop), issued
+/// after a read has streamed a few sectors at single or double speed. The
+/// total runs from the command write to the INT2 that ends it, so the first
+/// response (a few tens of thousands of clocks, under one HBlank tick per
+/// thousand) is included.
+fn cd_stop_pause_while_reading(double_speed: bool, command: u8) -> u16 {
+    let mode = if double_speed {
+        psx_hw::cd::MODE_DOUBLE_SPEED
+    } else {
+        0
+    };
+    if psx_io::cd::try_set_mode(mode, CD_SPINS).is_none()
+        || !cd_park(CD_TEST_LBA)
+        || psx_io::cd::try_set_target_lba(CD_TEST_LBA, CD_SPINS).is_none()
+        || psx_io::cd::try_start_reading(CD_SPINS).is_none()
+    {
+        cd_clock_reset();
+        let _ = cd_command_until_complete_timed(psx_hw::cd::CMD_PAUSE, &[]);
+        return CD_FAILED;
+    }
+    // Let the read settle: four sectors, so the drive is genuinely streaming.
+    cd_clock_reset();
+    let mut streaming = true;
+    let mut seen = 0;
+    while seen < 4 {
+        if !cd_sector_timed() {
+            streaming = false;
+            break;
+        }
+        seen += 1;
+    }
+    let elapsed = if streaming {
+        cd_timed(|| cd_command_until_complete_timed(command, &[]))
+    } else {
+        CD_FAILED
+    };
+    // Leave the drive paused and at single speed for whatever runs next.
+    cd_clock_reset();
+    let _ = cd_command_until_complete_timed(psx_hw::cd::CMD_PAUSE, &[]);
+    let _ = psx_io::cd::try_set_mode(0, CD_SPINS);
+    elapsed
+}
+
+/// Stop with the motor on and the drive idle (parked, paused). The motor
+/// stays off afterwards; the next record that needs it spins it up itself.
+fn cd_stop_from_idle() -> u16 {
+    if !cd_park(CD_TEST_LBA) {
+        return CD_FAILED;
+    }
+    cd_timed(|| cd_command_until_complete_timed(psx_hw::cd::CMD_STOP, &[]))
 }
 
+/// Stop when the drive is already stopped, in system clocks to the INT2.
+fn cd_stop_when_stopped_cycles() -> u16 {
+    cd_clock_reset();
+    if !cd_command_until_complete_timed(psx_hw::cd::CMD_STOP, &[]) {
+        return CD_FAILED;
+    }
+    cd_irq_cycles(psx_hw::cd::CMD_STOP, &[], 2)
+}
